# ============================================
# Vue 前端 .gitignore
# ============================================

# 依赖
node_modules/
.pnp
.pnp.js

# 构建输出
dist/
build/

# 环境配置（包含敏感信息）
.env.local
.env.*.local
.env.development.local
.env.production.local

# IDE 配置
.idea/
.vscode/
*.swp
*.swo
*~

# 日志
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 测试覆盖率
coverage/

# 操作系统
.DS_Store
Thumbs.db

# 浏览器缓存
.cache/

# 临时文件
*.tmp
*.temp
