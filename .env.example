# ============================================
# 环境变量模板
# 复制此文件为 .env 并填入实际值
# ============================================

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_NAME=employee_db
DB_USERNAME=root
DB_PASSWORD=123456

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT配置（必须修改！）
JWT_SECRET=your_random_secret_key_here_at_least_32_chars

# AES加密密钥（必须修改！）
AES_KEY=your_32_char_encryption_key_here

# 文件上传目录
FILE_UPLOAD_DIR=D:/uploads

# IP白名单（留空则不限制）
IP_WHITELIST=

# MinIO配置（可选）
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
